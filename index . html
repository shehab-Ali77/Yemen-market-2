# Yemen-market-2<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>سوق اليمن</title>
<style>
*{margin:0;padding:0;box-sizing:border-box;font-family:system-ui,sans-serif}
:root{--p:#1e6b3f;--a:#d4a017;--bg:#f5f7fa;--t:#1a2332;--m:#6b7a8f;--b:#e1e5ea}
body{background:var(--bg);color:var(--t)}
header{background:var(--p);color:#fff;padding:10px 14px;display:flex;justify-content:space-between;align-items:center;position:sticky;top:0;z-index:10;gap:8px}
.logo{font-weight:bold;font-size:14px}.logo span{color:var(--a)}
.roles{display:flex;gap:4px}
.roles button{padding:5px 8px;border:1px solid rgba(255,255,255,.3);background:transparent;color:#fff;border-radius:5px;font-size:10px}
.roles button.on{background:var(--a);color:#000;border-color:var(--a)}
.cart-btn{font-size:12px;cursor:pointer}
.wrap{padding:14px;max-width:1200px;margin:auto}
.tabs{display:flex;gap:4px;border-bottom:2px solid var(--b);margin-bottom:14px;overflow-x:auto}
.tab{padding:8px 12px;background:none;border:none;color:var(--m);border-bottom:3px solid transparent;white-space:nowrap;font-size:12px;cursor:pointer}
.tab.on{color:var(--p);border-color:var(--p);font-weight:bold}
.grid{display:grid;gap:10px;grid-template-columns:repeat(auto-fill,minmax(150px,1fr))}
.card{background:#fff;border:1px solid var(--b);border-radius:8px;padding:10px}
.stat{text-align:center;padding:14px}
.stat .n{font-size:20px;font-weight:bold;color:var(--p)}
.stat .l{font-size:11px;color:var(--m)}
.pr{cursor:pointer}.pr:hover{border-color:var(--p)}
.icon{height:80px;display:flex;align-items:center;justify-content:center;font-size:38px;background:#e8f5e9;border-radius:6px}
h3{font-size:13px;margin:6px 0 4px}
.price{color:var(--p);font-weight:bold;font-size:14px}
.muted{color:var(--m);font-size:11px}
.btn{padding:6px 12px;border:none;border-radius:5px;font-size:12px;font-weight:500;cursor:pointer}
.bp{background:var(--p);color:#fff}.ba{background:var(--a);color:#000}
.bo{background:none;border:1px solid var(--b)}
.bd{background:#dc3545;color:#fff}
.bs{padding:3px 8px;font-size:11px}
.flex{display:flex;gap:6px;align-items:center}
.fb{display:flex;justify-content:space-between;align-items:center}
.mt{margin-top:10px}.mb{margin-bottom:10px}
.badge{padding:2px 7px;border-radius:10px;font-size:10px;display:inline-block}
.bg{background:#d4edda;color:#155724}.bw{background:#fff3cd;color:#856404}
table{width:100%;border-collapse:collapse;font-size:12px}
th,td{padding:7px;text-align:right;border-bottom:1px solid var(--b)}
th{background:#f8f9fb;color:var(--m);font-size:11px}
.drawer{position:fixed;top:0;left:0;width:320px;max-width:85vw;height:100vh;background:#fff;transform:translateX(-100%);transition:.3s;z-index:100;padding:16px;overflow-y:auto;box-shadow:4px 0 20px rgba(0,0,0,.15)}
.drawer.on{transform:translateX(0)}
.ov{position:fixed;inset:0;background:rgba(0,0,0,.4);opacity:0;pointer-events:none;transition:.3s;z-index:99}
.ov.on{opacity:1;pointer-events:auto}
.hide{display:none!important}
.modal{position:fixed;inset:0;background:rgba(0,0,0,.5);display:none;align-items:center;justify-content:center;padding:14px;z-index:200}
.modal.on{display:flex}
.mc{background:#fff;border-radius:10px;padding:16px;max-width:500px;width:100%}
input,select{width:100%;padding:7px;border:1px solid var(--b);border-radius:5px;font-size:13px}
.toast{position:fixed;bottom:14px;left:14px;background:#1a2332;color:#fff;padding:10px 14px;border-radius:6px;transform:translateY(80px);opacity:0;transition:.3s;z-index:300;font-size:12px;max-width:80vw}
.toast.on{transform:translateY(0);opacity:1}
.toast.ok{background:#28a745}.toast.err{background:#dc3545}
.city{padding:3px 9px;border-radius:10px;font-size:11px;background:#e8f5e9;color:var(--p);cursor:pointer;display:inline-block;margin:2px;border:1px solid transparent}
.city.on{background:var(--p);color:#fff}
.bars{display:flex;gap:6px;height:110px;align-items:flex-end;background:#f8f9fb;padding:8px;border-radius:6px;margin-bottom:20px}
.bar{flex:1;background:linear-gradient(to top,var(--p),#4caf50);border-radius:3px 3px 0 0;position:relative;min-height:8px}
.bar span{position:absolute;top:-14px;left:0;right:0;text-align:center;font-size:9px;font-weight:bold}
.bar i{position:absolute;bottom:-16px;left:0;right:0;text-align:center;font-size:9px;color:var(--m);font-style:normal}
</style>
</head>
<body>

<header>
  <div class="logo">🛒 سوق<span>اليمن</span></div>
  <div class="roles">
    <button id="r-buyer" class="on" onclick="app.role('buyer')">مشتري</button>
    <button id="r-seller" onclick="app.role('seller')">بائع</button>
    <button id="r-admin" onclick="app.role('admin')">مدير</button>
  </div>
  <div class="cart-btn" onclick="cart.toggle()">🛍️ <span id="cc">0</span></div>
</header>

<div id="v-buyer" class="wrap">
  <div class="tabs">
    <button class="tab on" onclick="app.tab('buyer','home',this)">🏠 الرئيسية</button>
    <button class="tab" onclick="app.tab('buyer','shop',this)">📦 المنتجات</button>
    <button class="tab" onclick="app.tab('buyer','orders',this)">📋 طلباتي</button>
    <button class="tab" onclick="app.tab('buyer','wallet',this)">💰 محفظتي</button>
  </div>
  <div id="buyer-home" class="sec">
    <div class="grid mb">
      <div class="card stat"><div class="n">4</div><div class="l">مدن</div></div>
      <div class="card stat"><div class="n">12+</div><div class="l">بائع</div></div>
      <div class="card stat"><div class="n">250+</div><div class="l">منتج</div></div>
      <div class="card stat"><div class="n">24h</div><div class="l">توصيل</div></div>
    </div>
    <h3>🇾🇪 اختر مدينتك</h3>
    <div id="cities" class="mb"></div>
    <h3>🔥 منتجات مميزة</h3>
    <div class="grid" id="feat"></div>
  </div>
  <div id="buyer-shop" class="sec hide">
    <input placeholder="🔍 ابحث..." oninput="prod.render()" id="q" class="mb">
    <div class="grid" id="all"></div>
  </div>
  <div id="buyer-orders" class="sec hide"><h3>📋 طلباتي</h3><div id="ordList"></div></div>
  <div id="buyer-wallet" class="sec hide">
    <h3>💰 محفظتي</h3>
    <div class="grid"><div class="card stat"><div class="n" id="wb">0</div><div class="l">رصيد (ر.ي)</div></div></div>
    <div class="card mt"><h3>طرق الدفع</h3><p class="muted">💳 بطاقات • 📱 الكريمي • 💵 عند الاستلام</p></div>
  </div>
</div>

<div id="v-seller" class="wrap hide">
  <div class="tabs">
    <button class="tab on" onclick="app.tab('seller','dash',this)">📊 التحكم</button>
    <button class="tab" onclick="app.tab('seller','prods',this)">📦 منتجاتي</button>
    <button class="tab" onclick="app.tab('seller','sord',this)">📋 الطلبات</button>
  </div>
  <div id="seller-dash" class="sec">
    <div class="grid mb">
      <div class="card stat"><div class="n" id="sr">0</div><div class="l">مبيعات</div></div>
      <div class="card stat"><div class="n" id="so">0</div><div class="l">طلبات</div></div>
      <div class="card stat"><div class="n" id="sp">0</div><div class="l">منتجات</div></div>
      <div class="card stat"><div class="n">4.8⭐</div><div class="l">تقييم</div></div>
    </div>
    <div class="card mb"><h3>📈 مبيعات الأسبوع</h3><div class="bars" id="sc"></div></div>
    <div class="card"><h3>🔔 النشاطات</h3>
      <p class="muted">🛒 طلب جديد من صنعاء</p>
      <p class="muted">⭐ تقييم 5 نجوم</p>
      <p class="muted">💰 تحويل 450,000 ر.ي</p>
    </div>
  </div>
  <div id="seller-prods" class="sec hide">
    <div class="fb mb"><h3>📦 منتجاتي</h3><button class="btn bp" onclick="seller.addForm()">+ إضافة</button></div>
    <div class="card"><table><thead><tr><th>منتج</th><th>سعر</th><th>مخزون</th><th>حذف</th></tr></thead><tbody id="spt"></tbody></table></div>
  </div>
  <div id="seller-sord" class="sec hide">
    <h3>📋 الطلبات</h3>
    <div class="card"><table><thead><tr><th>#</th><th>عميل</th><th>مبلغ</th><th>حالة</th></tr></thead><tbody id="sot"></tbody></table></div>
  </div>
</div>

<div id="v-admin" class="wrap hide">
  <div class="tabs">
    <button class="tab on" onclick="app.tab('admin','ov',this)">📊 عام</button>
    <button class="tab" onclick="app.tab('admin','sel',this)">🏪 بائعون</button>
    <button class="tab" onclick="app.tab('admin','kyc',this)">🆔 KYC</button>
  </div>
  <div id="admin-ov" class="sec">
    <div class="grid mb">
      <div class="card stat"><div class="n" id="gmv">0</div><div class="l">GMV</div></div>
      <div class="card stat"><div class="n" id="com">0</div><div class="l">عمولة 5%</div></div>
      <div class="card stat"><div class="n">1,234</div><div class="l">مستخدم</div></div>
      <div class="card stat"><div class="n" id="as">0</div><div class="l">بائعون نشطون</div></div>
    </div>
    <div class="card"><h3>📈 مبيعات 7 أيام</h3><div class="bars" id="ac"></div></div>
  </div>
  <div id="admin-sel" class="sec hide">
    <h3>🏪 إدارة البائعين</h3>
    <div class="card"><table><thead><tr><th>بائع</th><th>مدينة</th><th>مبيعات</th><th>حالة</th><th></th></tr></thead><tbody id="ast"></tbody></table></div>
  </div>
  <div id="admin-kyc" class="sec hide"><h3>🆔 طلبات KYC</h3><div id="kycList"></div></div>
</div>

<div class="ov" id="ov" onclick="cart.toggle()"></div>
<aside class="drawer" id="dr">
  <div class="fb mb"><h3>🛍️ السلة</h3><button class="btn bo bs" onclick="cart.toggle()">✕</button></div>
  <div id="ci"></div>
  <div id="cs" class="mt"></div>
</aside>
<div class="modal" id="md"><div class="mc" id="mdc"></div></div>
<div class="toast" id="to"></div>

<script>
const $=id=>document.getElementById(id);
const f=n=>n.toLocaleString('ar-YE');
const toast=(m,t='ok')=>{const e=$('to');e.textContent=m;e.className='toast on '+t;setTimeout(()=>e.className='toast '+t,2200);};

const DB={
  user:{name:'أحمد اليماني',wallet:150000},
  cities:[{id:'sa',n:'صنعاء',on:true,sh:1500},{id:'ad',n:'عدن',sh:2500},{id:'tz',n:'تعز',sh:2000},{id:'hd',n:'الحديدة',sh:2500}],
  sellers:[
    {id:1,n:'متجر النور',c:'صنعاء',r:4.8,p:45,s:1250000,st:'active',v:true},
    {id:2,n:'بازار عدن',c:'عدن',r:4.5,p:32,s:890000,st:'active',v:true},
    {id:3,n:'تاج تعز',c:'تعز',r:4.2,p:28,s:650000,st:'active',v:false},
    {id:4,n:'سوق الحديدة',c:'الحديدة',r:4.6,p:20,s:430000,st:'pending',v:false}
  ],
  products:[
    {id:1,n:'سامسونج A15',p:185000,o:210000,c:'إلكترونيات',s:1,st:15,x:23,i:'📱',ct:'صنعاء'},
    {id:2,n:'لابتوب Dell',p:420000,o:0,c:'إلكترونيات',s:2,st:8,x:5,i:'💻',ct:'عدن'},
    {id:3,n:'بن يمني 1كغ',p:12000,o:15000,c:'أغذية',s:1,st:120,x:340,i:'☕',ct:'صنعاء'},
    {id:4,n:'عسل سدر',p:45000,o:0,c:'أغذية',s:3,st:35,x:78,i:'🍯',ct:'تعز'},
    {id:5,n:'ثوب رجالي',p:18500,o:22000,c:'ملابس',s:3,st:50,x:95,i:'👕',ct:'تعز'},
    {id:6,n:'ساعة Xiaomi',p:65000,o:0,c:'إلكترونيات',s:2,st:22,x:44,i:'⌚',ct:'عدن'},
    {id:7,n:'زيت جوز هند',p:8500,o:0,c:'تجميل',s:4,st:80,x:120,i:'🧴',ct:'الحديدة'},
    {id:8,n:'أواني منزلية',p:32000,o:38000,c:'منزل',s:1,st:18,x:29,i:'🍽️',ct:'صنعاء'},
    {id:9,n:'شاحن 65W',p:14500,o:0,c:'إلكترونيات',s:2,st:60,x:88,i:'🔌',ct:'عدن'},
    {id:10,n:'عطر شرقي',p:22000,o:28000,c:'تجميل',s:4,st:40,x:67,i:'🌸',ct:'الحديدة'},
    {id:11,n:'حقيبة جلدية',p:27000,o:0,c:'ملابس',s:3,st:25,x:33,i:'🎒',ct:'تعز'},
    {id:12,n:'مكواة بخار',p:38000,o:45000,c:'منزل',s:1,st:12,x:19,i:'♨️',ct:'صنعاء'}
  ],
  cart:[],orders:[],
  kyc:[{id:1,s:'سوق الحديدة',d:'سجل تجاري'},{id:2,s:'متجر الفجر',d:'بطاقة'},{id:3,s:'بازار المستقبل',d:'رخصة'}]
};

const app={
  cur:'buyer',
  role(r){
    this.cur=r;
    ['buyer','seller','admin'].forEach(x=>{
      $('v-'+x).classList.toggle('hide',x!==r);
      $('r-'+x).classList.toggle('on',x===r);
    });
    if(r==='seller')seller.render();
    if(r==='admin')admin.render();
    if(r==='buyer')prod.render();
  },
  tab(role,name,btn){
    document.querySelectorAll('#v-'+role+' .tab').forEach(t=>t.classList.remove('on'));
    btn.classList.add('on');
    document.querySelectorAll('#v-'+role+' .sec').forEach(s=>s.classList.add('hide'));
    $(role+'-'+name).classList.remove('hide');
    if(role==='buyer'&&name==='orders')order.render();
    if(role==='buyer'&&name==='wallet')$('wb').textContent=f(DB.user.wallet);
  }
};

const cities={
  render(){$('cities').innerHTML=DB.cities.map(c=>`<span class="city ${c.on?'on':''}" onclick="cities.sel('${c.id}')">${c.n}${c.on?' ✓':''}</span>`).join('');},
  sel(id){DB.cities.forEach(c=>c.on=c.id===id);this.render();toast('✅ '+DB.cities.find(c=>c.id===id).n);}
};

const prod={
  render(){
    const q=($('q')?.value||'').toLowerCase();
    const l=DB.products.filter(p=>p.n.toLowerCase().includes(q));
    $('all').innerHTML=l.map(p=>this.html(p)).join('')||'<p class="muted">لا نتائج</p>';
  },
  feat(){$('feat').innerHTML=DB.products.slice(0,8).map(p=>this.html(p)).join('');},
  html(p){
    const s=DB.sellers.find(x=>x.id===p.s);
    const d=p.o?Math.round((1-p.p/p.o)*100):0;
    return `<div class="card pr" onclick="prod.show(${p.id})">
      <div class="icon">${p.i}</div>
      ${d?`<span class="badge" style="background:#f8d7da;color:#721c24">-${d}%</span>`:''}
      <h3>${p.n}</h3>
      <div class="muted">🏪 ${s.n} • 📍 ${p.ct}</div>
      <div class="fb mt">
        <div>
          <div class="price">${f(p.p)} ر.ي</div>
          ${p.o?`<div class="muted" style="text-decoration:line-through">${f(p.o)}</div>`:''}
        </div>
        <button class="btn bp bs" onclick="event.stopPropagation();cart.add(${p.id})">+ سلة</button>
      </div>
    </div>`;
  },
  show(id){
    const p=DB.products.find(x=>x.id===id);
    const s=DB.sellers.find(x=>x.id===p.s);
    $('mdc').innerHTML=`<div class="fb mb"><h3>${p.n}</h3><button class="btn bo bs" onclick="md.close()">✕</button></div>
      <div class="icon" style="height:120px;font-size:60px">${p.i}</div>
      <h3 class="mt">${f(p.p)} ر.ي ${p.o?`<span class="muted" style="text-decoration:line-through">${f(p.o)}</span>`:''}</h3>
      <p class="muted mt">${p.c} • ${p.ct} • مخزون ${p.st}</p>
      <p class="mt">🏪 <strong>${s.n}</strong> ⭐${s.r} ${s.v?'✅':'⏳'}</p>
      <button class="btn bp mt" onclick="cart.add(${p.id});md.close()">🛍️ أضف للسلة</button>`;
    md.open();
  }
};

const cart={
  toggle(){$('dr').classList.toggle('on');$('ov').classList.toggle('on');this.render();},
  add(id){
    const it=DB.cart.find(x=>x.id===id);
    if(it)it.q++;
    else DB.cart.push({...DB.products.find(p=>p.id===id),q:1});
    $('cc').textContent=DB.cart.reduce((a,b)=>a+b.q,0);
    toast('✅ أضيف للسلة');
  },
  setQ(id,q){const it=DB.cart.find(x=>x.id===id);if(it){it.q=Math.max(1,q);this.render();}},
  del(id){DB.cart=DB.cart.filter(x=>x.id!==id);$('cc').textContent=DB.cart.reduce((a,b)=>a+b.q,0);this.render();},
  tot(){return DB.cart.reduce((a,b)=>a+b.p*b.q,0);},
  render(){
    if(!DB.cart.length){
      $('ci').innerHTML='<p class="muted" style="text-align:center;padding:30px">السلة فارغة</p>';
      $('cs').innerHTML='';
      return;
    }
    $('ci').innerHTML=DB.cart.map(i=>`<div class="card mb">
      <div class="fb">
        <div><strong style="font-size:12px">${i.i} ${i.n}</strong><div class="price">${f(i.p)} ر.ي</div></div>
        <div>
          <button class="btn bo bs" onclick="cart.setQ(${i.id},${i.q-1})">−</button>
          ${i.q}
          <button class="btn bo bs" onclick="cart.setQ(${i.id},${i.q+1})">+</button>
        </div>
        <button class="btn bd bs" onclick="cart.del(${i.id})">🗑️</button>
      </div>
    </div>`).join('');
    const sub=this.tot();
    const sh=DB.cities.find(c=>c.on)?.sh||0;
    $('cs').innerHTML=`<div class="card">
      <div class="fb"><span>مجموع:</span><strong>${f(sub)}</strong></div>
      <div class="fb mt"><span>شحن:</span><strong>${f(sh)}</strong></div>
      <hr style="margin:8px 0;border:none;border-top:1px solid #eee">
      <div class="fb"><strong>إجمالي:</strong><strong class="price">${f(sub+sh)}</strong></div>
      <button class="btn ba" style="width:100%;margin-top:8px" onclick="order.checkout()">✅ إتمام الشراء</button>
    </div>`;
  }
};

const order={
  checkout(){
    if(!DB.cart.length)return toast('السلة فارغة','err');
    const sh=DB.cities.find(c=>c.on)?.sh||0;
    const t=cart.tot()+sh;
    if(t>DB.user.wallet)return toast('❌ رصيد غير كافٍ','err');
    DB.user.wallet-=t;
    const o={id:1000+DB.orders.length+1,items:[...DB.cart],tot:t,st:'pending',d:new Date().toLocaleDateString('ar-YE'),ct:DB.cities.find(c=>c.on)?.n};
    DB.orders.push(o);
    DB.cart=[];
    $('cc').textContent=0;
    cart.toggle();
    toast('🎉 طلب #'+o.id+' تم!');
    setTimeout(()=>{o.st='confirmed';toast('✅ طلب #'+o.id+' مؤكد');},2500);
    setTimeout(()=>{o.st='shipped';toast('🚚 طلب #'+o.id+' في الطريق');},5000);
  },
  render(){
    if(!DB.orders.length){
      $('ordList').innerHTML='<div class="card" style="text-align:center;padding:30px"><p class="muted">لا طلبات</p></div>';
      return;
    }
    const st={pending:['⏳','bw','قيد المعالجة'],confirmed:['✅','bg','مؤكد'],shipped:['🚚','bw','في الطريق']};
    $('ordList').innerHTML=DB.orders.slice().reverse().map(o=>`<div class="card mb">
      <div class="fb">
        <div><strong>طلب #${o.id}</strong><div class="muted">${o.d} • ${o.ct}</div></div>
        <span class="badge ${st[o.st][1]}">${st[o.st][0]} ${st[o.st][2]}</span>
      </div>
      <div class="mt">${o.items.map(i=>`<span class="badge bw">${i.i} ${i.n}×${i.q}</span> `).join('')}</div>
      <strong class="price mt">${f(o.tot)} ر.ي</strong>
    </div>`).join('');
  }
};

const seller={
  render(){
    const s=DB.sellers[0];
    const mp=DB.products.filter(p=>p.s===s.id);
    $('sr').textContent=f(s.s);
    $('so').textContent=DB.orders.length+12;
    $('sp').textContent=mp.length;
    $('spt').innerHTML=mp.map(p=>`<tr>
      <td>${p.i} ${p.n}</td><td>${f(p.p)}</td><td>${p.st}</td>
      <td><button class="btn bd bs" onclick="seller.del(${p.id})">🗑️</button></td>
    </tr>`).join('');
    const ords=DB.orders.length?DB.orders:[{id:1001,ct:'صنعاء',tot:185000,st:'pending'},{id:1002,ct:'عدن',tot:12000,st:'confirmed'}];
    $('sot').innerHTML=ords.map(o=>`<tr>
      <td>#${o.id}</td><td>أحمد</td><td>${f(o.tot)}</td>
      <td><span class="badge bw">${o.st}</span></td>
    </tr>`).join('');
    const d=['س','ح','ن','ث','ر','خ','ج'],v=[40,65,30,80,95,55,70];
    $('sc').innerHTML=v.map((x,i)=>`<div class="bar" style="height:${x}%"><span>${x}k</span><i>${d[i]}</i></div>`).join('');
  },
  del(id){if(confirm('حذف؟')){DB.products=DB.products.filter(p=>p.id!==id);this.render();prod.render();toast('🗑️ حذف','err');}},
  addForm(){
    $('mdc').innerHTML=`<h3>➕ منتج جديد</h3>
      <input id="an" placeholder="اسم" class="mt">
      <input id="ap" type="number" placeholder="سعر" class="mt">
      <input id="as" type="number" placeholder="مخزون" class="mt">
      <select id="ac" class="mt">
        <option>إلكترونيات</option><option>ملابس</option>
        <option>أغذية</option><option>منزل</option><option>تجميل</option>
      </select>
      <button class="btn bp mt" onclick="seller.add()">✅ إضافة</button>`;
    md.open();
  },
  add(){
    const n=$('an').value,p=+$('ap').value,s=+$('as').value,c=$('ac').value;
    if(!n||!p)return toast('اكمل البيانات','err');
    const ic={'إلكترونيات':'📦','ملابس':'👕','أغذية':'🍯','منزل':'🏠','تجميل':'🧴'};
    DB.products.push({id:Math.max(...DB.products.map(x=>x.id))+1,n,p,o:0,c,s:1,st:s,x:0,i:ic[c],ct:'صنعاء'});
    md.close();this.render();prod.render();prod.feat();
    toast('✅ تم');
  }
};

const admin={
  render(){
    const tot=DB.sellers.reduce((a,b)=>a+b.s,0);
    $('gmv').textContent=f(tot);
    $('com').textContent=f(Math.round(tot*.05));
    $('as').textContent=DB.sellers.filter(s=>s.st==='active').length;
    $('ast').innerHTML=DB.sellers.map(s=>`<tr>
      <td>${s.v?'✅':'⏳'} ${s.n}</td><td>${s.c}</td><td>${f(s.s)}</td>
      <td><span class="badge ${s.st==='active'?'bg':'bw'}">${s.st==='active'?'نشط':'معلق'}</span></td>
      <td><button class="btn bo bs" onclick="admin.tog(${s.id})">${s.st==='active'?'تعليق':'تنشيط'}</button></td>
    </tr>`).join('');
    $('kycList').innerHTML=DB.kyc.map(k=>`<div class="card mb fb">
      <div><strong>${k.s}</strong><div class="muted">${k.d}</div></div>
      <div class="flex">
        <button class="btn bp bs" onclick="admin.app(${k.id})">✅</button>
        <button class="btn bd bs" onclick="admin.rej(${k.id})">❌</button>
      </div>
    </div>`).join('')||'<p class="muted">لا طلبات</p>';
    const d=['س','ح','ن','ث','ر','خ','ج'],v=[120,180,150,220,260,190,240];
    $('ac').innerHTML=v.map((x,i)=>`<div class="bar" style="height:${x/300*100}%"><span>${x}k</span><i>${d[i]}</i></div>`).join('');
  },
  tog(id){const s=DB.sellers.find(x=>x.id===id);s.st=s.st==='active'?'suspended':'active';this.render();toast('تم التحديث');},
  app(id){DB.kyc=DB.kyc.filter(k=>k.id!==id);this.render();toast('✅ قبل');},
  rej(id){DB.kyc=DB.kyc.filter(k=>k.id!==id);this.render();toast('❌ رفض','err');}
};

const md={open(){$('md').classList.add('on');},close(){$('md').classList.remove('on');}};

cities.render();
prod.render();
prod.feat();
</script>
</body>
</html>
